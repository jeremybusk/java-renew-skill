{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Java Renew policy (partial layers allowed)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "baseline_java": {
      "type": "integer",
      "minimum": 8,
      "maximum": 25
    },
    "target_java": {
      "type": "integer",
      "minimum": 8,
      "maximum": 25
    },
    "source_release": {
      "type": "integer",
      "minimum": 8,
      "maximum": 25
    },
    "framework_policy": {
      "type": "string",
      "enum": [
        "preserve",
        "compatible",
        "current-supported"
      ]
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eol": {
          "type": "string",
          "enum": [
            "replace",
            "report"
          ]
        },
        "vulnerabilities": {
          "type": "string",
          "enum": [
            "fix",
            "report"
          ]
        },
        "allow_major_upgrades": {
          "type": "boolean"
        },
        "max_review_age_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 365
        }
      }
    },
    "allow_preview": {
      "type": "boolean"
    },
    "dependency_pins": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[^:\\s]+:[^:\\s]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?!.*SNAPSHOT)[0-9][0-9A-Za-z._-]*$"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude_dirs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^/\\\\]+$",
            "minLength": 1
          }
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        },
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "required_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "owner",
          "reason",
          "expires",
          "ticket"
        ],
        "properties": {
          "gate": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "expires": {
            "type": "string",
            "format": "date"
          },
          "ticket": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resource_targets": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "tool",
              "jdk",
              "gradle-plugin",
              "image"
            ]
          },
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
