{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Java modernization stage handoff",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "stage", "status", "inventory_sha256", "policy_sha256", "summary", "versions", "findings", "decisions", "changes", "validation", "blockers", "next_steps"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "stage": {"type": "string", "enum": ["assess", "plan", "execute", "validate", "summary"]},
    "status": {"type": "string", "enum": ["in_progress", "blocked", "complete"]},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {"type": "string", "minLength": 1},
    "versions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component", "before", "after", "source", "checked_on"],
        "properties": {
          "component": {"type": "string", "minLength": 1},
          "before": {"type": "string", "minLength": 1},
          "after": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "checked_on": {"type": "string", "format": "date"}
        }
      }
    },
    "findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "decisions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "changes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validation": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "next_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
